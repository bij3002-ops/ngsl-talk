# Google AI Studio에서 발급한 Gemini API 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Live API 모델 ID
GEMINI_LIVE_MODEL=gemini-3.8-live
API_PORT=8787

# --- 배포용 ---
# 공개 주소로 배포할 때 반드시 설정하세요. 비워 두면 비밀번호 없이 열립니다(로컬 개발용).
APP_PASSWORD=
# 로그인 쿠키 서명 키. 비워 두면 서버가 재시작될 때마다 다시 로그인해야 합니다. (예: openssl rand -hex 32)
SESSION_SECRET=
# Postgres 연결 주소 (Supabase → Connect → Transaction pooler). 배포 환경에서는 반드시 설정하세요.
# 비워 두면 로컬 개발용 내장 Postgres(PGlite)를 backend/data/pglite에 만듭니다.
DATABASE_URL=
